{
  "table": "character_master",
  "display_name": "キャラクター",
  "fields": [
    {
      "name": "name",
      "type": "string",
      "display_name": "名前",
      "required": true,
      "export": true,
      "validation": {
        "max_length": 32,
        "unique": true
      }
    },
    {
      "name": "defense",
      "type": "int",
      "display_name": "防御力",
      "export": true,
      "validation": {
        "min": 0,
        "max": 9999
      }
    },
    {
      "name": "rarity",
      "type": "enum",
      "display_name": "レアリティ",
      "enum_ref": "rarity",
      "export": true
    },
    {
      "name": "hp",
      "type": "int",
      "display_name": "HP",
      "export": false,
      "validation": {
        "min": 1,
        "max": 99999
      },
      "anomaly": {
        "warn_above": 10000,
        "warn_below": 50
      }
    },
    {
      "name": "attack_power",
      "type": "string",
      "display_name": "攻撃力",
      "formula": "10"
    },
    {
      "name": "skill_ids",
      "type": "list<int>",
      "display_name": "スキル",
      "ref": "skill_master.id",
      "validation": {
        "max_length": 3
      }
    },
    {
      "name": "effective_hp",
      "type": "float",
      "display_name": "実効HP",
      "formula": "hp * (1 + defense / 10)",
      "editable": false
    },
    {
      "name": "dev_memo",
      "type": "string",
      "display_name": "開発メモ",
      "export": false
    }
  ],
  "records": [
    {
      "id": 1,
      "version": "0.1.2",
      "name": "勇者アルス",
      "rarity": "SSR",
      "hp": 200,
      "defense": 50,
      "skill_ids": [
        1,
        3,
        7
      ],
      "effective_hp": {
        "override": "hp*2"
      }
    },
    {
      "id": 2,
      "version": "0.1.0",
      "name": "魔法使いリナ",
      "rarity": "SR",
      "hp": {
        "value": 800,
        "color": "red",
        "comment": "次回バランス調整で1000に変更予定"
      },
      "defense": 30,
      "skill_ids": [
        2,
        5
      ]
    },
    {
      "id": 3,
      "version": "0.1.11",
      "name": "盾の騎士ガルド",
      "rarity": "SSR",
      "hp": 1500,
      "defense": {
        "value": 80,
        "color": "yellow",
        "comment": "QAから硬すぎると報告あり #1234"
      },
      "skill_ids": [
        1,
        4
      ],
      "effective_hp": {
        "override": "hp * 2",
        "color": "blue",
        "comment": "特殊計算：イベント限定仕様"
      }
    }
  ]
}